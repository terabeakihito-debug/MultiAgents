{
  "name": "multi-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.heavy.config.ts && vitest run --config vitest.light.config.ts",
    "state:restore": "node scripts/state-restore.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
